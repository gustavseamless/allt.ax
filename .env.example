# PostgreSQL connection string (managed PostgreSQL in production, e.g. Neon/Supabase/RDS)
DATABASE_URL="postgresql://alltax:alltax_dev@localhost:5432/alltax"

# Auth.js secret – generate with: openssl rand -base64 32
AUTH_SECRET="change-me"
AUTH_TRUST_HOST="true"

# Public base URL, used for canonical URLs, sitemap and Open Graph
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

